# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=App
APP_ENV=local
APP_KEY=                                  # generated by harness/init.sh
APP_DEBUG=true
APP_URL=http://localhost:8080             # nginx container host port

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC                          # API always emits UTC

# Set false in prod to hide /docs (public JSON/OpenAPI docs endpoint)
DOCS_PUBLIC=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (docker compose service: pgsql — host port 5433) ──────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql                             # container DNS; host tools use 127.0.0.1:5433
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# ─── Cache / Queue / Session ────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database                   # API-only: sessions rarely used; keep db for octane-safety
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Mail (mailpit: UI http://localhost:8025) ───────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Object storage (optional: docker compose --profile storage up -d) ──────
FILESYSTEM_DISK=local                     # switch to s3 once the storage profile is used
AWS_ACCESS_KEY_ID=app
AWS_SECRET_ACCESS_KEY=app-dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=private-assets
AWS_ENDPOINT=http://rustfs:9000           # container DNS; host: http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Auth ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173   # if/when SPA cookie auth is added; bearer-only can ignore

# ─── Realtime (optional, --profile realtime) ────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http                        # REQUIRED for local server->reverb calls (SSL timeout otherwise)

# ─── Frontend CORS allowlist (comma-separated origins; empty = no cross-origin) ──
FRONTEND_ORIGINS=

# ─── Throttling / misc knobs your modules will read ─────────────────────────
# AUDIT_RETENTION_DAYS=365
