{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "constitution.md",
    "docs/architecture.md",
    "docs/conventions.md",
    "docs/api-conventions.md",
    "src/AGENTS.md"
  ],
  "permission": {
    "bash": {
      "php *": "deny",
      "composer *": "deny",
      "artisan *": "deny",
      "./vendor/bin/*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout *": "ask",
      "*": "allow"
    }
  }
}
